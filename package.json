{
  "name": "@kud/harness-fme",
  "version": "0.1.0",
  "type": "module",
  "description": "Headless Harness FME (Split) admin API client: typed reads, rate-limited requests and a safe plan, backup, write and read-back engine for flag changes.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "harness",
    "fme",
    "split",
    "feature-flags",
    "api-client",
    "typescript"
  ],
  "homepage": "https://kud.io/projects/harness-fme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kud/harness-fme.git"
  },
  "author": "kud",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
